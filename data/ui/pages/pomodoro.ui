<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <template class="PomodoroView" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="hexpand">True</property>
    <property name="vexpand">True</property>

    <child>
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="vexpand">True</property>
            <child>
              <object class="AdwClamp">
                <property name="maximum-size">460</property>
                <property name="tightening-threshold">360</property>
                <property name="margin-start">16</property>
                <property name="margin-end">16</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">16</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">16</property>
                    <property name="valign">start</property>

                    <!-- Mode Switcher -->
                    <child>
                      <object class="GtkBox">
                        <property name="halign">center</property>
                        <property name="spacing">4</property>
                        <style>
                          <class name="mode-switcher"/>
                          <class name="linked"/>
                        </style>
                        <child>
                          <object class="GtkToggleButton" id="mode_focus_toggle">
                            <property name="label" translatable="yes">Focus</property>
                            <property name="active">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="mode_short_toggle">
                            <property name="label" translatable="yes">Short Break</property>
                            <property name="group">mode_focus_toggle</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="mode_long_toggle">
                            <property name="label" translatable="yes">Long Break</property>
                            <property name="group">mode_focus_toggle</property>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Status Pill -->
                    <child>
                      <object class="GtkBox">
                        <property name="halign">center</property>
                        <child>
                          <object class="GtkLabel" id="status_label">
                            <property name="label" translatable="yes">Focus · Ready</property>
                            <style>
                              <class name="status-chip"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Hero Timer Card -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">8</property>
                        <property name="halign">fill</property>
                        <property name="hexpand">True</property>
                        <style>
                          <class name="card"/>
                          <class name="timer-hero-card"/>
                        </style>

                        <child>
                          <object class="GtkLabel" id="timer_label">
                            <property name="label">25:00</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="timer-display"/>
                            </style>
                          </object>
                        </child>

                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">REMAINING</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="timer-phase-caption"/>
                            </style>
                          </object>
                        </child>

                        <child>
                          <object class="GtkProgressBar" id="progress_bar">
                            <property name="fraction">0.0</property>
                            <property name="hexpand">True</property>
                            <style>
                              <class name="timer-progress"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Action Controls -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">16</property>
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <property name="margin-top">2</property>
                        <property name="margin-bottom">2</property>

                        <child>
                          <object class="GtkButton" id="reset_button">
                            <property name="icon-name">view-refresh-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Reset Timer</property>
                            <property name="width-request">40</property>
                            <property name="height-request">40</property>
                            <style>
                              <class name="circular"/>
                              <class name="secondary-action-btn"/>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>

                        <child>
                          <object class="GtkButton" id="start_button">
                            <property name="label" translatable="yes">Start</property>
                            <property name="halign">center</property>
                            <property name="width-request">124</property>
                            <property name="height-request">42</property>
                            <style>
                              <class name="suggested-action"/>
                              <class name="pill"/>
                              <class name="start-button"/>
                            </style>
                          </object>
                        </child>

                        <child>
                          <object class="GtkButton" id="skip_button">
                            <property name="icon-name">media-skip-forward-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Skip</property>
                            <property name="width-request">40</property>
                            <property name="height-request">40</property>
                            <style>
                              <class name="circular"/>
                              <class name="secondary-action-btn"/>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Focus Music / Ambience Card -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <style>
                          <class name="card"/>
                          <class name="ambient-card"/>
                        </style>

                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>

                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">audio-headphones-symbolic</property>
                                <property name="pixel-size">20</property>
                                <style>
                                  <class name="accent"/>
                                </style>
                              </object>
                            </child>

                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">2</property>
                                <property name="hexpand">True</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Focus Ambience</property>
                                    <property name="halign">start</property>
                                    <style>
                                      <class name="heading"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Ambient soundscapes for deep focus</property>
                                    <property name="halign">start</property>
                                    <style>
                                      <class name="caption"/>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="GtkSwitch" id="music_switch">
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox" id="music_controls_box">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">10</property>
                            <property name="sensitive">False</property>

                            <child>
                              <object class="GtkDropDown" id="track_dropdown">
                                <property name="hexpand">True</property>
                              </object>
                            </child>

                            <child>
                              <object class="GtkButton" id="music_file_button">
                                <property name="icon-name">folder-open-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Choose local audio file</property>
                                <style>
                                  <class name="circular"/>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </child>

                            <child>
                              <object class="GtkButton" id="music_play_button">
                                <property name="icon-name">media-playback-start-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Play / Pause</property>
                                <style>
                                  <class name="circular"/>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </child>

                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">audio-volume-low-symbolic</property>
                                    <property name="pixel-size">14</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkScale" id="volume_scale">
                                    <property name="width-request">65</property>
                                    <property name="draw-value">False</property>
                                    <property name="adjustment">
                                      <object class="GtkAdjustment">
                                        <property name="lower">0</property>
                                        <property name="upper">100</property>
                                        <property name="value">60</property>
                                        <property name="step-increment">5</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">audio-volume-high-symbolic</property>
                                    <property name="pixel-size">14</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Statistics Section -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="homogeneous">True</property>
                        <property name="spacing">14</property>
                        <property name="margin-top">2</property>

                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <style>
                              <class name="card"/>
                              <class name="stat-box"/>
                            </style>

                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">trophy-symbolic</property>
                                    <property name="pixel-size">16</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Completed</property>
                                    <property name="halign">start</property>
                                    <style>
                                      <class name="stat-label"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="sessions_today_value">
                                <property name="label">0 sessions</property>
                                <property name="halign">start</property>
                                <style>
                                  <class name="stat-value"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <style>
                              <class name="card"/>
                              <class name="stat-box"/>
                            </style>

                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">preferences-system-time-symbolic</property>
                                    <property name="pixel-size">16</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Focus Time</property>
                                    <property name="halign">start</property>
                                    <style>
                                      <class name="stat-label"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="focus_time_value">
                                <property name="label">0m</property>
                                <property name="halign">start</property>
                                <style>
                                  <class name="stat-value"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
