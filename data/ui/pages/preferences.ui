<?xml version="1.0" encoding="UTF-8" ?>
<interface>
  <requires lib="gtk" version="4.0" />
  <requires lib="Adw" version="1.0" />

  <template class="TomotoroPreferences" parent="AdwPreferencesDialog">
    <property name="title" translatable="yes">Preferences</property>

    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">General</property>
        <property name="icon-name">tomotoro-preferences-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Timer</property>

            <child>
              <object class="AdwSpinRow" id="focus_length_row">
                <property name="title" translatable="yes">Focus Length</property>
                <property name="subtitle" translatable="yes">Minutes per focus session</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">120</property>
                    <property name="value">25</property>
                    <property name="step-increment">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="break_length_row">
                <property name="title" translatable="yes">Break Length</property>
                <property name="subtitle" translatable="yes">Minutes per break session</property>

                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">90</property>
                    <property name="value">5</property>
                    <property name="step-increment">1</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Behavior</property>

            <child>
              <object class="AdwSwitchRow" id="auto_start_breaks_row">
                <property name="title" translatable="yes">Auto-start Breaks</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="auto_start_focus_row">
                <property name="title" translatable="yes">Auto-start Focus Sessions</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="sound_row">
                <property name="title" translatable="yes">Play Sound on Completion</property>
                <property name="active">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Music</property>
        <property name="icon-name">tomotoro-music-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup" id="music_actions_group">
            <property name="title" translatable="yes">Custom Tracks</property>
            <property
                            name="description"
                            translatable="yes"
                        >Add local audio files or a folder. Supported formats are detected automatically and appear in the Pomodoro track list.</property>

            <child>
              <object class="AdwSwitchRow" id="play_with_timer_row">
                <property name="title" translatable="yes">Play Alongside Pomodoro</property>
                <property name="subtitle" translatable="yes">Start music automatically when a session starts</property>
              </object>
            </child>

            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Add Music Files</property>
                <property name="subtitle" translatable="yes">Select one or more audio files</property>
                <child type="suffix">
                  <object class="GtkButton" id="add_files_button">
                    <property name="icon-name">list-add-symbolic</property>
                    <property name="valign">center</property>
                    <property name="tooltip-text" translatable="yes">Add music files</property>
                    <style>
                      <class name="flat" />
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Add Folder</property>
                <property name="subtitle" translatable="yes">Import every supported track in a folder</property>
                <child type="suffix">
                  <object class="GtkButton" id="add_folder_button">
                    <property name="icon-name">folder-new-symbolic</property>
                    <property name="valign">center</property>
                    <property name="tooltip-text" translatable="yes">Add music folder</property>
                    <style>
                      <class name="flat" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup" id="custom_tracks_group">
            <property name="title" translatable="yes">Selected Tracks</property>
            <property name="description" translatable="yes">Tracks available in the Pomodoro music dropdown</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
