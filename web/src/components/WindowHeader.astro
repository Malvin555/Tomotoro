---
interface Props {
  title?: string;
}

const { title = 'Tomotoro' } = Astro.props;
---

<div class="flex h-12 items-center justify-between bg-head px-3 rounded-t-[1.1rem]">
  <span class="h-6 w-6"></span>
  <span class="font-display text-sm font-bold">{title}</span>
  <span class="grid h-6 w-6 place-items-center rounded-full bg-black/10 text-xs">
    ✕
  </span>
</div>
